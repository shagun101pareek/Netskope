# Local development defaults. Copy this file to .env before installing or migrating.
# These credentials are for the Docker Compose services on your machine only.

NODE_ENV=development

# PostgreSQL. The container listens on 5432; the host port is 5434 so this
# project does not attach to another Postgres already bound to 5432.
DATABASE_URL=postgresql://netskope:netskope@localhost:5434/netskope?schema=public

# Redis. The container listens on 6379; the host port is 6380 for the same reason.
REDIS_URL=redis://localhost:6380

# Fastify API
API_HOST=0.0.0.0
API_PORT=3011
API_URL=http://localhost:3011

# Browser origin allowed to call the API. 3010 avoids a Next.js app already bound to 3000.
WEB_ORIGIN=http://localhost:3010

LOG_LEVEL=info
