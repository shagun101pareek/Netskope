{
  "name": "netskope",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @netskope/database db:generate",
    "db:migrate": "pnpm --filter @netskope/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @netskope/database db:migrate:deploy",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.13"
  }
}
